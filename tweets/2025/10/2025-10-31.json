  "translations": {
    "1984210992881098913": {
      "pikapaca": true,
      "translation": "票子……\n票子……\n\n买、买上了"
    },
    "1984211747813601590": {
      "pikapaca": true,
      "translation": "去东京的票"
    },
    "1984212503040266483": {
      "pikapaca": true,
      "translation": "怎、怎怎怎怎怎怎么办\n\n啊手已经开始抖了"
    },
    "1984213257746350268": {
      "pikapaca": true,
      "translation": "但我身边有着为了让那双手温暖起来\n而握着那双手笑着的朋友\n我觉得那样就足够了"
    },
    "1984214013241110848": {
      "pikapaca": true,
      "translation": "奇迹酱的身上一直带着甜甜的点心香气\n看到她的笑容，觉得自己的心也变得柔软了🐱"
    },
    "1984214768249704794": {
      "pikapaca": true,
      "translation": "她总是说想做出能给人带来笑容的点心，但不知为何，对于我来说，奇迹酱本身大概就能给我带来笑容了🐱✨\n这样跟她说了之后，她说：“这就是被称为条件反射的东西哦”🙀"
    },
    "1984215522842722362": {
      "pikapaca": true,
      "translation": "“饲养成功🎂🍩 ” 怎么这样说……😿"
    },
    "1984216277917766137": {
      "pikapaca": true,
      "translation": "总之！\n今天已经就此全力以赴了，所以接下来什么都不去想……\n向波尔卡酱学习🐱✨\n\n下周的事，下周再想就好了！！！"
    }
