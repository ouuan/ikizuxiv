  "translations": {
    "1986347067971981662": {
      "pikapaca": true,
      "translation": "今天有很多事要做所以就只说这个💻"
    },
    "1986347823244177452": {
      "pikapaca": true,
      "translation": "别用生日当密码哦💩\n\n听到了吗？\n那里的波尔卡\n说的就是你哦？"
    },
    "1986373996003098660": {
      "pikapaca": true,
      "translation": "秋天一到，就不知道为什么会有点烦躁，果然是因为考试季即将来临了，是吧🎩✨"
    },
    "1986374750550310943": {
      "pikapaca": true,
      "translation": "虽然直到1月为止都可以报名，但“是不是早报名会更能感受到热情呢”，或是“顺序太靠前会被更严格对待呢？”🩰\n有好多在考虑的事，导致每天都在烦恼中度过🥰\n果然不管是什么情况考试都很麻烦呢！"
    },
    "1986375506086773237": {
      "pikapaca": true,
      "translation": "虽然我今年并不准备考试，但看着乃理子酱的样子，果然还是有点蠢蠢欲动\n不过我觉得带着这种心情去考试是不对的🎩🪄"
    },
    "1986376260570767375": {
      "pikapaca": true,
      "translation": "歌剧团的初试仅凭30秒左右就决定了 \n真的是命运呢🩰 🪄"
    },
    "1986377015260234029": {
      "pikapaca": true,
      "translation": "一生中仅有4回\n但对任何人来说都平等的机会\n做出让今后不会后悔的选择\n一定只是这样吧"
    },
    "1986377770323329112": {
      "pikapaca": true,
      "translation": "凝视我心中透明冰冷的泉水水面的话\n究竟会映出什么呢……"
    },
    "1986378525264216504": {
      "pikapaca": true,
      "translation": "试着想象了一下，就浮现出了波尔卡笑着把石头扔向水面激起大波纹的样子！\n已经什么都见不到了呢🥰"
    }
